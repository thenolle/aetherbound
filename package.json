{
  "name": "aetherbound",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Aetherbound: Shattered Concord - original 3D collectible card battler",
  "scripts": {
    "dev": "bun --watch src/server/main.ts",
    "start": "bun run src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "balance": "bun run src/tools/balance.ts",
    "test": "bun test",
    "deps:check": "bun run src/tools/check-deps.ts",
    "season:close": "bun run src/tools/close-season.ts",
    "db:backup": "bun run src/tools/backup.ts",
    "db:check": "bun run src/tools/check-db.ts",
    "verify": "bun run deps:check && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}